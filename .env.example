# Generate safe local development credentials with: python3 scripts/dev_env.py
POSTGRES_PASSWORD=
ATLAS_DATABASE_URL=postgresql+psycopg://atlasops:REPLACE@127.0.0.1:5432/atlasops
ATLAS_REDIS_URL=redis://127.0.0.1:6379/0
ATLAS_MODE=production
ATLAS_DEV_AUTH_ENABLED=false
ATLAS_DEV_AUTH_SECRET=
ATLAS_OIDC_ISSUER=
ATLAS_OIDC_AUDIENCE=
ATLAS_OIDC_JWKS_URL=
ATLAS_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
ATLAS_INTEGRATION_HOSTS=
ATLAS_ALLOW_INSECURE_INTEGRATIONS=false
ATLAS_REPORT_TIMEZONE=Asia/Kolkata
ATLAS_REPORT_HOUR=8
ATLAS_SMTP_HOST=
ATLAS_SMTP_PORT=587
ATLAS_SMTP_STARTTLS=true
ATLAS_SMTP_SENDER=atlasops@example.com
ATLAS_REPORT_RECIPIENT=
ATLAS_SMTP_USERNAME=
ATLAS_SMTP_PASSWORD_REF=
ATLAS_AI_URL=
ATLAS_AI_MODEL=
ATLAS_AI_SECRET_REF=
# OpenAI key is local-only, secret-aware, ignored by Git, and never returned by the API.
OPENAI_API_KEY=
ATLAS_AI_PROVIDER=compatible
# For OpenAI, set ATLAS_AI_PROVIDER=openai and ATLAS_AI_URL=https://api.openai.com/v1
# Select a model you have access to and explicitly choose its supported capabilities.
ATLAS_AI_ALLOWED_HOSTS=api.openai.com
ATLAS_AI_RESPONSE_FORMAT=json_schema
ATLAS_AI_TOKEN_PARAMETER=max_completion_tokens
ATLAS_AI_MAX_OUTPUT_TOKENS=2500
ATLAS_AI_MAX_ITERATIONS=4
ATLAS_AI_MAX_TOOL_CALLS=8
ATLAS_AI_MAX_QUERY_WINDOW_SECONDS=7200
ATLAS_AI_MAX_EVIDENCE=100
ATLAS_AI_MAX_CONTEXT_BYTES=60000
ATLAS_AI_MAX_OUTPUT_BYTES=32768
ATLAS_AI_REQUEST_TIMEOUT_SECONDS=15
ATLAS_AI_MAX_ELAPSED_SECONDS=60
